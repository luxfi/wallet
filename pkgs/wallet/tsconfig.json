{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.json",
    "env.d.ts"
  ],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx", "src/test/**"],
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "src/*": ["./src/*"]
    }
  }
}
