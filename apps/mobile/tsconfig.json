{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Mobile App",
  "extends": "../../tsconfig.base.json",
  "exclude": [".storybook/storybook.requires.ts"],
  "references": [
    {
      "path": "../../pkgs/wallet"
    }
  ],
  "compilerOptions": {
    "types": ["jest", "node"],
    "paths": {
      "src/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "src/polyfills/**/*.js", "global.d.ts"]
}
